<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WonderLust</title>
</head>
<body>
    <h3>Edit Listings</h3>
    <form method="POST" action="/listings/edit">
        <input listing.title type="text" placeholder="New listing">
        <br><br>
        <input listing.description type="description" placeholder="New description">
        <br><br>
        <input listing.image type="text" placeholder="New url">
        <br><br>
        <input listing.price type="text" placeholder="New price">
        <br><br>
        <input listing.location type="text" placeholder="New location">
        <br><br>
        <input listing.country type="text" placeholder="New country">
        <br><br>
        <button>submit</button>
    </form>
</body>
</html>